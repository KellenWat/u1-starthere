    {
      "id": "firmware",
      "kind": "question",
      "title": "Is Paxx12 already installed?",
      "help": "An installed-firmware answer does not assume a particular mod or completed stock-test history.",
      "choices": [
        {
          "id": "installed",
          "label": "Yes, explore features and integrations",
          "next": "software",
          "set": {
            "stage": "paxx12"
          }
        },
        {
          "id": "stock",
          "label": "No, explore the firmware decision",
          "next": "plan"
        },
        {
          "id": "unsure",
          "label": "I’m not sure",
          "next": "plan"
        }
      ]
    },
    {
      "id": "symptoms",
      "kind": "question",
      "title": "What are you noticing?",
      "help": "Choose the closest description. We only link to guides already in the curated data.",
      "choices": [
        {
          "id": "quality",
          "label": "Print surface or adhesion",
          "next": "quality"
        },
        {
          "id": "filament",
          "label": "Filament feeding or identification",
          "next": "filament"
        },
        {
          "id": "noise",
          "label": "Noise, fans or temperatures",
          "next": "noise"
        },
        {
          "id": "head",
          "label": "Toolhead or calibration",
          "next": "head"
        },
        {
          "id": "odor",
          "label": "Fumes or enclosure odor",
          "next": "odor"
        },
        {
          "id": "none",
          "label": "No fault — explore improvements",
          "next": "plan"
        }
      ]
    },
    {
      "id": "quality",
      "kind": "question",
      "title": "What is happening to the print?",
      "help": "Choose a specific observation, or continue without assuming a cause.",
      "choices": [
        {
          "id": "tower",
          "label": "Prime tower falls over",
          "next": "fix-prime-tower-toppling"
        },
        {
          "id": "bands",
          "label": "Vertical bands change with wall speed",
          "next": "fix-vfa-banding"
        },
        {
          "id": "stuck",
          "label": "Part is stuck on CryoGrip",
          "next": "fix-cryogrip-part-stuck"
        },
        {
          "id": "faster",
          "label": "No fault — I want faster prints",
          "next": "plan",
          "set": {
            "bothers": [
              "speed-flow"
            ]
          }
        },
        {
          "id": "other",
          "label": "Something else",
          "next": "unmatched"
        }
      ]
    },
    {
      "id": "filament",
      "kind": "question",
      "title": "What is happening with the filament?",
      "help": "Dry feeding, spool identification and runout faults take different routes.",
      "choices": [
        {
          "id": "first-load",
          "label": "I haven’t loaded filament yet",
          "next": "track-filament"
        },
        {
          "id": "identify",
          "label": "The spool is no longer identified",
          "next": "dryer"
        },
        {
          "id": "runout",
          "label": "One head reports unexpected runout",
          "next": "fix-runout-sensor-errors"
        },
        {
          "id": "dry",
          "label": "No fault — plan drying and dry feed",
          "next": "plan",
          "set": {
            "bothers": [
              "dry-filament"
            ]
          }
        },
        {
          "id": "filament-printing-anomaly",
          "label": "Printing pauses with a feed anomaly",
          "next": "fix-filament-printing-anomaly"
        },
        {
          "id": "other",
          "label": "Something else",
          "next": "unmatched"
        }
      ]
    },
    {
      "id": "dryer",
      "kind": "question",
      "title": "Are you feeding from a dryer?",
      "help": "This distinguishes the documented dryer-feed identification case from other recognition problems.",
      "choices": [
        {
          "id": "yes",
          "label": "Yes, directly from a dryer",
          "next": "fix-dryer-feed-rfid-loss"
        },
        {
          "id": "no",
          "label": "No, the spool is on the printer",
          "next": "filament-identification"
        },
        {
          "id": "unsure",
          "label": "I’m not sure",
          "next": "unmatched"
        }
      ]
    },
    {
      "id": "noise",
      "kind": "question",
      "title": "Which sound or reading concerns you?",
      "help": "Do not treat a fan fault as a reason to modify the printer before investigating it.",
      "choices": [
        {
          "id": "idle",
          "label": "Fan whine near the PSU at idle",
          "next": "fix-psu-fan-whine"
        },
        {
          "id": "fan",
          "label": "One toolhead fan cuts out",
          "next": "fix-pogo-fan-dropout"
        },
        {
          "id": "temp",
          "label": "Driver temperature looks high",
          "next": "fix-driver-temperature-baseline"
        },
        {
          "id": "vibration",
          "label": "No fault — reduce vibration or noise",
          "next": "plan",
          "set": {
            "bothers": [
              "noise"
            ]
          }
        },
        {
          "id": "other",
          "label": "Something else",
          "next": "unmatched"
        }
      ]
    },
