    {
      "id": "start",
      "kind": "question",
      "title": "What’s next for your U1?",
      "help": "Start with what you need. We’ll connect the useful next steps.",
      "choices": [
        {
          "id": "new",
          "label": "Get started",
          "next": "setup",
          "description": "From delivery to a clean stock baseline"
        },
        {
          "id": "improve",
          "label": "Improve my setup",
          "next": "improve",
          "description": "Make one useful change at a time"
        },
        {
          "id": "problem",
          "label": "Something isn’t working",
          "next": "symptoms",
          "description": "Find a guide or narrow down the symptom"
        },
        {
          "id": "explore",
          "label": "Explore what’s possible",
          "next": "explore",
          "description": "Materials, more colors and firmware features"
        }
      ]
    },
    {
      "id": "setup",
      "kind": "question",
      "title": "Where are you starting?",
      "help": "Stock first, mods second. Keep a clean baseline before changing the printer.",
      "choices": [
        {
          "id": "waiting",
          "label": "Waiting for my U1",
          "next": "track",
          "set": {
            "stage": "not-arrived"
          }
        },
        {
          "id": "assembled",
          "label": "Assembled; first-start setup is next",
          "next": "track-setup",
          "set": {
            "stage": "stock"
          }
        },
        {
          "id": "filament",
          "label": "I need to load filament",
          "next": "track-filament"
        },
        {
          "id": "file",
          "label": "I need a first print file",
          "next": "track-first-file"
        },
        {
          "id": "ready",
          "label": "Ready for my next change",
          "next": "improve",
          "set": {
            "stage": "stock"
          }
        }
      ]
    },
    {
      "id": "improve",
      "kind": "question",
      "title": "What would make printing better?",
      "help": "A specific symptom can lead straight to its guide. A broader goal leads to a plan.",
      "choices": [
        {
          "id": "software",
          "label": "Software & integrations",
          "description": "Apps, firmware features and community tools",
          "next": "software"
        },
        {
          "id": "noise",
          "label": "Less noise",
          "next": "noise",
          "set": {
            "bothers": [
              "noise"
            ]
          }
        },
        {
          "id": "reliable",
          "label": "More reliable prints",
          "next": "symptoms",
          "set": {
            "bothers": [
              "reliability"
            ]
          }
        },
        {
          "id": "fumes",
          "label": "Manage fumes",
          "next": "odor",
          "set": {
            "bothers": [
              "fumes"
            ]
          }
        },
        {
          "id": "dry",
          "label": "Keep filament dry",
          "next": "filament",
          "set": {
            "bothers": [
              "dry-filament"
            ]
          }
        },
        {
          "id": "speed",
          "label": "Faster printing",
          "next": "quality",
          "set": {
            "bothers": [
              "speed-flow"
            ]
          }
        },
        {
          "id": "colors",
          "label": "More color options",
          "next": "plan",
          "set": {
            "bothers": [
              "color-count"
            ],
            "materials": "colors"
          }
        },
        {
          "id": "general",
          "label": "Show useful improvements",
          "next": "plan"
        }
      ]
    },
    {
      "id": "explore",
