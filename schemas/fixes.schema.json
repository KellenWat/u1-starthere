{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "license",
    "imported_at",
    "attribution",
    "fixes"
  ],
  "properties": {
    "version": {
      "const": "1.2.0"
    },
    "license": {
      "const": "CC-BY-4.0"
    },
    "imported_at": {
      "type": "string",
      "format": "date"
    },
    "attribution": {
      "$ref": "common.schema.json#/$defs/attribution"
    },
    "fixes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "symptoms",
          "title",
          "likely_cause",
          "steps",
          "stop_if",
          "severity",
          "related_items",
          "codes",
          "source",
          "last_verified",
          "verified_firmware",
          "support_url",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "symptoms": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 3
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "likely_cause": {
            "type": "string",
            "minLength": 1
          },
          "steps": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "stop_if": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "info",
              "caution",
              "stop"
            ]
          },
          "related_items": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "uniqueItems": true
          },
          "codes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "source": {
            "$ref": "common.schema.json#/$defs/source"
          },
          "last_verified": {
            "type": "string",
            "format": "date"
          },
          "verified_firmware": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "support_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://[^\\s]+$"
          },
          "provenance": {
            "$ref": "common.schema.json#/$defs/provenance"
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://u1-starthere.example/schemas/fixes.schema.json"
}
