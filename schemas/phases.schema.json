{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "license",
    "imported_at",
    "attribution",
    "phases",
    "milestones"
  ],
  "properties": {
    "version": {
      "const": "1.6.0"
    },
    "license": {
      "const": "CC-BY-4.0"
    },
    "imported_at": {
      "type": "string",
      "format": "date"
    },
    "attribution": {
      "$ref": "common.schema.json#/$defs/attribution"
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phase",
          "name",
          "goal",
          "steps"
        ],
        "properties": {
          "phase": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "goal": {
            "type": "string",
            "minLength": 1
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "text",
                "item_id"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "item_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "optional": {
                  "type": "boolean",
                  "default": false
                },
                "requires_steps": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "$ref": "common.schema.json#/$defs/id"
                  }
                },
                "guidance": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "actions",
                    "done_when",
                    "if_stuck",
                    "sources",
                    "last_verified",
                    "verification_status"
                  ],
                  "properties": {
                    "actions": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "done_when": {
                      "type": "string",
                      "minLength": 1
                    },
                    "if_stuck": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sources": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "$ref": "common.schema.json#/$defs/source"
                      }
                    },
                    "last_verified": {
                      "$ref": "common.schema.json#/$defs/date"
                    },
                    "verification_status": {
                      "const": "source-reviewed-not-tested"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "milestones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "step_ids",
          "complete_text"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "step_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "common.schema.json#/$defs/id"
            }
          },
          "complete_text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://u1-starthere.example/schemas/phases.schema.json"
}
